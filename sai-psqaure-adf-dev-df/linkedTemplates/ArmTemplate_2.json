							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_looup_homework",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Check If Count is greater than 500",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Lookup Orders Data",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
