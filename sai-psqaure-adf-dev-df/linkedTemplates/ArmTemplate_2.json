								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Filter all CSV Files').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
