{
	"name": "pl_s11_hw01_lookup_email",
	"properties": {
		"activities": [
			{
				"name": "act_lookup_order_count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Orders",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "act_if_order_count_greater_than_500",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "act_lookup_order_count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('act_lookup_order_count').output.count, 500)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "act_fail_record_limit_not_achieved",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "act_web_send_record_limit_email",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Record limit has not been achieved yet",
								"errorCode": "ORDER_COUNT_LESS_THAN_500"
							}
						},
						{
							"name": "act_web_send_record_limit_email",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"headers": {
									"Content-Type": "application/json"
								},
								"url": "https://prod-14.centralindia.logic.azure.com:443/workflows/a372e456268046eab1259e1df930417d/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=IoXIZcGDBjt8DBtCE-DuQP1zykmNpcixWAP_oAwQASI",
								"body": {
									"value": "@concat(\n'{\"receiver\":\"saiazurejobpracticegmail.com\",\"subject\":\"ADF Alert: Order record limit not achieved\",\"message\":\"Record limit has not been achieved yet.\",\"pipelineName\":\"',\npipeline().Pipeline,\n'\",\"runId\":\"',\npipeline().RunId,\n'\"}'\n)",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "act_copy_orders_to_adls",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureSQL_Orders",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_adls_orders_parquet",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}